{
    "description": "Insert an internal link to a header, assigning the header an id if it doesn't have one.",
    "tests": [
        {
            "description": "Insert link to H1 - collapsed selection inserts header text as link",
            "startHtml": "<h1>Introduction</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"introduction\">Introduction</h1><p>Some text.<a href=\"#introduction\">Introduction</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to H1 - non-empty selection wraps it as a link",
            "startHtml": "<h1>Introduction</h1><p>|Some text.|</p>",
            "endHtml": "<h1 id=\"introduction\">Introduction</h1><p>|<a href=\"#introduction\">Some text.</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to second H2 - only the targeted header is assigned an id",
            "startHtml": "<h2>First</h2><h2>Second</h2><p>Some text.|</p>",
            "endHtml": "<h2>First</h2><h2 id=\"second\">Second</h2><p>Some text.<a href=\"#second\">Second</a>|</p>",
            "action": "MU.insertInternalLink('H2', 1)"
        },
        {
            "description": "Insert link when the preceding same-level header is empty - index 1 still targets the real header, matching what getHeaders() reports for it",
            "startHtml": "<h2></h2><h2>Real</h2><p>Some text.|</p>",
            "endHtml": "<h2></h2><h2 id=\"real\">Real</h2><p>Some text.<a href=\"#real\">Real</a>|</p>",
            "action": "MU.insertInternalLink('H2', 1)"
        },
        {
            "description": "Insert link to header with punctuation - punctuation is dropped from the id as GitHub does",
            "startHtml": "<h1>What's new, really?</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"whats-new-really\">What's new, really?</h1><p>Some text.<a href=\"#whats-new-really\">What's new, really?</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to header keeps hyphens, underscores, digits and non-ASCII letters",
            "startHtml": "<h1>Über_cool 2-step</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"über_cool-2-step\">Über_cool 2-step</h1><p>Some text.<a href=\"#über_cool-2-step\">Über_cool 2-step</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to a second header with the same text - id gets a hyphen and number as GitHub does",
            "startHtml": "<h2 id=\"setup\">Setup</h2><h2>Setup</h2><p>Some text.|</p>",
            "endHtml": "<h2 id=\"setup\">Setup</h2><h2 id=\"setup-1\">Setup</h2><p>Some text.<a href=\"#setup-1\">Setup</a>|</p>",
            "action": "MU.insertInternalLink('H2', 1)"
        },
        {
            "description": "Insert link to a third header with the same text - suffix is 2, not appended to the previous suffix",
            "startHtml": "<h2 id=\"setup\">Setup</h2><h2 id=\"setup-1\">Setup</h2><h2>Setup</h2><p>Some text.|</p>",
            "endHtml": "<h2 id=\"setup\">Setup</h2><h2 id=\"setup-1\">Setup</h2><h2 id=\"setup-2\">Setup</h2><p>Some text.<a href=\"#setup-2\">Setup</a>|</p>",
            "action": "MU.insertInternalLink('H2', 2)"
        },
        {
            "description": "Insert link to a very long header - id is cut to 40 characters",
            "startHtml": "<h6>This paragraph text is long enough to be cut at forty characters</h6><p>Some text.|</p>",
            "endHtml": "<h6 id=\"this-paragraph-text-is-long-enough-to-be\">This paragraph text is long enough to be cut at forty characters</h6><p>Some text.<a href=\"#this-paragraph-text-is-long-enough-to-be\">This paragraph text is long enough to be cut at forty characters</a>|</p>",
            "action": "MU.insertInternalLink('H6', 0)"
        },
        {
            "description": "Insert link to header with superscript and circled digits - GitHub drops them",
            "startHtml": "<h1>x² ① y</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"x--y\">x² ① y</h1><p>Some text.<a href=\"#x--y\">x² ① y</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to header with emoji - the emoji is dropped and the leading hyphen stays",
            "startHtml": "<h1>😄 emoji</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"-emoji\">😄 emoji</h1><p>Some text.<a href=\"#-emoji\">😄 emoji</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to header with an emoji variation selector - GitHub keeps the selector",
            "startHtml": "<h1>I ❤️ it</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"i-️-it\">I ❤️ it</h1><p>Some text.<a href=\"#i-️-it\">I ❤️ it</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to header with connector punctuation and a circled letter - GitHub keeps them",
            "startHtml": "<h1>a‿b Ⓐ</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"a‿b-ⓐ\">a‿b Ⓐ</h1><p>Some text.<a href=\"#a‿b-ⓐ\">a‿b Ⓐ</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to header whose 40th character is outside the BMP - the cut keeps the whole character",
            "startHtml": "<h1>aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa𝒜𝒜</h1><p>Some text.|</p>",
            "endHtml": "<h1 id=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa𝒜\">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa𝒜𝒜</h1><p>Some text.<a href=\"#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa𝒜\">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa𝒜𝒜</a>|</p>",
            "action": "MU.insertInternalLink('H1', 0)"
        },
        {
            "description": "Insert link to the second of two untitled same-text headers first - id is numbered by position, as GitHub does",
            "startHtml": "<h2>Setup</h2><h2>Setup</h2><p>Some text.|</p>",
            "endHtml": "<h2>Setup</h2><h2 id=\"setup-1\">Setup</h2><p>Some text.<a href=\"#setup-1\">Setup</a>|</p>",
            "action": "MU.insertInternalLink('H2', 1)"
        }
    ]
}
